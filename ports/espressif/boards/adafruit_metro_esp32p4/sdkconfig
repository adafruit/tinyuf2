CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-16MB-ota4MB.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# This Metro revision uses the original P4 silicon, not ECO3.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_1=y

# Keep room for ADC double-reset detection in P4's 24 KB bootloader partition.
CONFIG_BOOTLOADER_LOG_LEVEL_ERROR=y
